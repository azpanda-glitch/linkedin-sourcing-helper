{
  "manifest_version": 3,
  "name": "Sourcing Helper — Boolean & X-ray Builder",
  "version": "0.1.0",
  "description": "Reads the job posting you're viewing and builds Boolean + X-ray search links to source candidates and related posts.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://api.anthropic.com/*",
    "https://api.peopledatalabs.com/*"
  ],
  "action": {
    "default_title": "Sourcing Helper",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/jobs/*", "https://www.linkedin.com/jobs/view/*"],
      "js": ["content/scrape.js"],
      "run_at": "document_idle"
    }
  ]
}
